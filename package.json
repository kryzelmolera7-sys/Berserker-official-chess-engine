{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "build:wasm": "clang++ --target=wasm32 -std=c++20 -O3 -msimd128 -mbulk-memory -fno-exceptions -fno-rtti -nostdlib -Wall -Wextra -Wno-unused-parameter -Wl,--no-entry,--export-dynamic,--initial-memory=268435456,--max-memory=536870912 -Wl,-z,stack-size=1048576 -o public/berserker-engine.wasm src/engine/cpp/berserker.cpp",
    "build:native": "mkdir -p bin && g++ -O3 -std=c++20 -march=native -pthread -DBERSERKER_NATIVE -Wall -Wextra -Wno-unused-parameter -o bin/berserker-native src/engine/cpp/berserker.cpp",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "chess.js": "^1.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "stockfish": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
