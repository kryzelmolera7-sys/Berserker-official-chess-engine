{
  "name": "Berserker v0.4.0",
  "version": "0.4.0",
  "author": "Berserker Engine Team",
  "country": "US",
  "command": "node berserker-v0.4.0-cli.js",
  "protocol": "UCI",
  "options": [
    { "name": "Threads", "type": "spin", "default": 4, "min": 1, "max": 256 },
    { "name": "Hash", "type": "spin", "default": 1024, "min": 16, "max": 65536 },
    { "name": "EvalFile", "type": "string", "default": "berserker_brnnue_v040.nnue" },
    { "name": "AuraMoE", "type": "check", "default": true },
    { "name": "ContinuationHistory", "type": "check", "default": true },
    { "name": "SingularExtensions", "type": "check", "default": true },
    { "name": "ProbCut", "type": "check", "default": true },
    { "name": "MultiCut", "type": "check", "default": true }
  ]
}
